{
  "type": "object",
  "properties": {
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "cliente",
              "vendedor"
            ]
          },
          "text": {
            "type": "string"
          },
          "media": {
            "const": "audio"
          },
          "transcription": {
            "type": "string"
          }
        },
        "required": [
          "role"
        ],
        "additionalProperties": false,
        "anyOf": [
          {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "required": [
              "media"
            ]
          }
        ]
      },
      "contains": {
        "properties": {
          "role": {
            "const": "cliente"
          }
        }
      }
    },
    "ad_product": {
      "type": "string"
    },
    "commercial": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "product": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "string",
            "minLength": 1
          },
          "destination": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "field": {
            "type": "string",
            "enum": [
              "beneficio",
              "composicao",
              "entrega",
              "estoque",
              "frete",
              "localizacao",
              "prazo",
              "preco"
            ]
          },
          "value": {
            "type": [
              "number",
              "boolean",
              "string"
            ]
          },
          "source": {
            "type": "string",
            "minLength": 1
          },
          "verified_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "product",
          "field",
          "value",
          "source",
          "verified_at"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "field": {
                  "enum": [
                    "preco",
                    "frete"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "field": {
                  "const": "preco"
                }
              }
            },
            "then": {
              "required": [
                "unit"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "field": {
                  "const": "estoque"
                }
              }
            },
            "then": {
              "required": [
                "size"
              ],
              "properties": {
                "value": {
                  "type": "boolean"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "field": {
                  "enum": [
                    "frete",
                    "prazo",
                    "entrega"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "destination"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "field": {
                  "const": "entrega"
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "boolean"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "field": {
                  "enum": [
                    "prazo",
                    "composicao",
                    "beneficio",
                    "localizacao"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    },
    "customer": {
      "type": "object",
      "properties": {
        "recorrente": {
          "type": "boolean"
        },
        "fonte": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [],
      "additionalProperties": false,
      "dependentRequired": {
        "recorrente": [
          "fonte"
        ]
      }
    },
    "follow_up_permission": {
      "type": "boolean"
    }
  },
  "required": [
    "messages"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Horizon IA V1 — conversa e fatos comerciais fornecidos pelo operador"
}
